# Copy to .env for local testing. On Cloud Run, set these as environment
# variables / secrets in the service config instead of a file.

PORT=8080

# Long random string — protects /api/admin/* and /api/sync.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-string

# Cloud Storage bucket name for proof-of-payment uploads (must exist already)
PROOF_OF_PAYMENT_BUCKET=welverdiend-proof-of-payment

# Google Cloud project id (used implicitly by Firestore/Storage clients
# when running on Cloud Run — only needed for local testing)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
