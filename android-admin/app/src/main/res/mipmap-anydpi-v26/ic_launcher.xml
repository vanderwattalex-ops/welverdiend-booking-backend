<?xml version="1.0" encoding="utf-8"?>
<!-- The site icon (taupe square, cream W), inset so the W sits inside the
     area every launcher shape keeps. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_bg" />
    <foreground>
        <inset android:drawable="@drawable/ic_launcher_art" android:inset="16%" />
    </foreground>
</adaptive-icon>
